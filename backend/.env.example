ASPNETCORE_ENVIRONMENT=Development
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=student_workforce;Username=student_workforce;Password=student_workforce_dev_password
ConnectionStrings__Redis=localhost:6379
REDIS_CONNECTION_STRING=localhost:6379

Jwt__Issuer=student-workforce-management
Jwt__Audience=student-workforce-management
Jwt__SigningKey=replace-with-32-plus-character-development-secret
Jwt__AccessTokenMinutes=15

Email__Provider=Development
Email__FromEmail=no-reply@example.invalid
Email__FromName=Student Workforce Management
Email__SendGridApiKey=
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__Username=
Email__Smtp__Password=

DataProtection__KeysPath=storage/keys

Storage__Provider=Local
Storage__LocalRootPath=storage/local
Storage__SignedUrlLifetimeMinutes=15
Storage__MaxFileSizeBytes=1073741824
Storage__StudentStorageQuotaBytes=5368709120
Storage__DepartmentStorageQuotaBytes=53687091200
Storage__S3__ServiceUrl=
Storage__S3__BucketName=
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__S3__ForcePathStyle=true

BackgroundJobs__EnableServer=true
BackgroundJobs__HangfireSchemaName=hangfire
BackgroundJobs__BatchSize=100
BackgroundJobs__JobRetryAttempts=3
BackgroundJobs__PendingUploadGraceMinutes=60

FRONTEND_APP_URL=http://localhost:5173
DISPLAY_TIMEZONE=Europe/Istanbul
