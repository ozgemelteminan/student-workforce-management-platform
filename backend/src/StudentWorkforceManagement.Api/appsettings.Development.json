{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "SigningKey": "DEV_ONLY_SIGNING_KEY_0123456789_32_CHARS_MIN"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Email": {
    "Provider": "Development",
    "DevelopmentSinkPath": "storage/dev-emails",
    "DevelopmentFrontendBaseUrl": "http://localhost:5173"
  },
  "DataProtection": {
    "KeysPath": "storage/keys"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage/local"
  },
  "BackgroundJobs": {
    "EnableServer": true,
    "HangfireSchemaName": "hangfire"
  },
  "Exports": {
    "ArtifactExpirationHours": 24
  }
}
