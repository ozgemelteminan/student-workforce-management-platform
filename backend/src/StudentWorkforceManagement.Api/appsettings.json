{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "StudentWorkforceManagement",
    "Audience": "StudentWorkforceManagement.Api",
    "SigningKey": "CHANGE_ME_USE_ENVIRONMENT_SECRET_32_CHARS_MINIMUM",
    "AccessTokenMinutes": 15
  },
  "Email": {
    "Provider": "Development",
    "FromEmail": "no-reply@example.invalid",
    "FromName": "Student Workforce Management",
    "BatchSize": 20,
    "MaxAttempts": 5,
    "BaseRetryDelayMinutes": 5,
    "ProviderTimeoutSeconds": 15
  },
  "DataProtection": {
    "KeysPath": "storage/keys"
  },
  "Storage": {
    "Provider": "Local",
    "MaxFileSizeBytes": 1073741824,
    "StudentStorageQuotaBytes": 10737418240,
    "DepartmentStorageQuotaBytes": 107374182400,
    "SignedUrlLifetimeMinutes": 15,
    "LocalRootPath": "storage/local",
    "S3": {
      "BucketName": "",
      "Region": "us-east-1",
      "ServiceUrl": "",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true
    }
  },
  "UploadFilePolicy": {
    "MaxFileSizeBytes": 1073741824,
    "AllowedMimeTypesByExtension": {
      ".doc": [ "application/msword" ],
      ".docx": [ "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ],
      ".xls": [ "application/vnd.ms-excel" ],
      ".xlsx": [ "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" ],
      ".ppt": [ "application/vnd.ms-powerpoint" ],
      ".pptx": [ "application/vnd.openxmlformats-officedocument.presentationml.presentation" ],
      ".odt": [ "application/vnd.oasis.opendocument.text" ],
      ".ods": [ "application/vnd.oasis.opendocument.spreadsheet" ],
      ".odp": [ "application/vnd.oasis.opendocument.presentation" ],
      ".pdf": [ "application/pdf" ],
      ".txt": [ "text/plain" ],
      ".csv": [ "text/csv", "application/csv" ],
      ".json": [ "application/json", "text/json" ],
      ".md": [ "text/markdown", "text/plain" ],
      ".png": [ "image/png" ],
      ".jpg": [ "image/jpeg" ],
      ".jpeg": [ "image/jpeg" ],
      ".webp": [ "image/webp" ],
      ".zip": [ "application/zip", "application/x-zip-compressed", "multipart/x-zip" ]
    }
  },
  "BackgroundJobs": {
    "EnableServer": true,
    "HangfireSchemaName": "hangfire",
    "BatchSize": 100,
    "JobRetryAttempts": 3,
    "PendingUploadGraceMinutes": 60
  },
  "Exports": {
    "ArtifactExpirationHours": 24
  }
}
